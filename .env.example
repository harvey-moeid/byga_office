# Copy to .dev.vars for local Worker development. Never commit real values.
# Selected defaults: OpenRouter primary; Gemini fallback.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Generate ADMIN_PASSWORD_HASH using npm run password:hash.
ADMIN_PASSWORD_HASH=
# Run npm run credentials:setup once; preserve this encryption key across restarts.
PROVIDER_KEYS_ENCRYPTION_KEY=
# Other providers are optional and configurable through Admin.
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
COHERE_API_KEY=
NVIDIA_API_KEY=
DISCORD_MEETING_WEBHOOK=
DISCORD_SIGNAL_WEBHOOK=
