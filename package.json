{
  "name": "byga-trading-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node scripts/wrangler.mjs dev --ip 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "security:audit": "npm audit --omit=dev --audit-level=high && npm audit --audit-level=critical",
    "format": "prettier --write src tests scripts",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply trading_office_db --local",
    "db:fixture": "node scripts/fixture.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "password:hash": "node scripts/password.mjs",
    "test:browser": "playwright test",
    "deploy:check": "node scripts/wrangler.mjs deploy --dry-run",
    "test:browser:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.180.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "miniflare": "^5.20261001.0-alpha",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
